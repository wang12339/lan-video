# Use multi-stage build on Mac to produce ARM64 linux binary, then package for router
# Stage 1: Build using Mac's cross-compilation (done externally with cargo build --target aarch64-unknown-linux-musl)
# Stage 2: Minimal runtime container

FROM alpine:3.19
RUN apk add --no-cache ca-certificates tzdata libgcc

WORKDIR /app
COPY backend/target/aarch64-unknown-linux-musl/release/lan-video-backend /app/

EXPOSE 8082
CMD ["/app/lan-video-backend"]
