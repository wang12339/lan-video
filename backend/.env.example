# ── Required ──
# PostgreSQL connection string
DATABASE_URL=postgres://user:password@localhost:5432/atmos_video

# ── Database ──
# Max pool connections (default: 100). Must be at least 1.
# DB_MAX_CONNECTIONS=100
# Override the auto-discovered migration directory (default: backend/migrations/)
# MIGRATIONS_DIR=/path/to/migrations

# ── Server ──
# Port to listen on (default: 8082)
# SERVER_PORT=8082

# ── Paths (default: relative to CWD) ──
# MEDIA_ROOT=./media
# WEBAPP_ROOT=./webapp/dist
# LOG_DIR=./logs
# DATA_DIR=./data

# ── Registration ──
# Set to "true" or "1" to allow new user signups.
# When disabled, users can only be created via direct DB insert.
# REGISTRATION_ENABLED=false

# ── CORS (安全) ──
# Comma-separated list of allowed origins.
# Default: empty (deny all cross-origin requests with credentials).
# CORS_ORIGIN=https://your-domain.com

# ── Required: Public URL ──
# External-accessible base URL. Used for share links, hotlink protection,
# and HTTPS redirects. Must be set in production.
PUBLIC_URL=https://atmos.your-domain.com

# ── Cookie security ──
# Set to "true" when serving over HTTPS (default: true).
# COOKIE_SECURE=true

# ── App environment ──
# Controls default behaviour:
# - "production" (unset, default): enables HTTPS redirect, strict CORS.
# - "development"/"dev": relaxed CORS for local dev.
# APP_ENV=production

# ── Per-user upload quota (A04 H2) ──
# Maximum bytes a single user can store. Default: 50 GB (53687091200).
# Set to 0 to disable quota enforcement.
# UPLOAD_QUOTA_BYTES=53687091200

# ── First-user admin guard (H-09) ──
# IMPORTANT: The first registered user will NOT become admin by default,
# even if REGISTRATION_ENABLED=true. Set to "true" only if you understand
# the security implications.
# ALLOW_FIRST_USER_ADMIN=false

# ── Email (SMTP) — required for password reset and email verification ──
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=noreply@your-domain.com
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM="Atmos Video <noreply@your-domain.com>"

# ── Optional integrations ──
# RUST_LOG=info
# SENTRY_DSN=https://...
# SENTRY_ENVIRONMENT=production

# ── Redis (optional; fallback to in-memory rate limiting / cache) ──
# REDIS_URL=redis://localhost:6379

# ── Client IP / proxy ──
# Set to "1"/"true" to trust X-Forwarded-For and cf-connecting-ip from any
# peer. Without it, Cloudflare header spoofing is only honored when the direct
# peer is inside Cloudflare's published ranges.
# TRUSTED_PROXY=0

# ── Hash ID salt ──
# Must be stable across restarts, otherwise hashed IDs change. Default salt is
# baked into the binary — set a random value in production.
# HASHID_SALT=change-me-to-a-long-random-string

# ── Transcoding ──
# Max seconds for a single ffmpeg transcode (default: 3600)
# TRANSCODE_TIMEOUT_SECS=3600
# Max seconds for a single ffprobe invocation (default: 30)
# FFPROBE_TIMEOUT_SECS=30
# Concurrent transcodes (default: 1)
# TRANSCODE_CONCURRENCY=1
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
