# ── Required ──
# PostgreSQL connection string
DATABASE_URL=postgres://user:password@localhost:5432/lan_video

# ── Server ──
# Port to listen on (default: 8082)
# SERVER_PORT=8082

# ── Paths (default: relative to CWD) ──
# MEDIA_ROOT=./media
# WEBAPP_ROOT=./webapp/dist
# LOG_DIR=./logs
# DATA_DIR=./data

# ── Registration ──
# Set to "true" or "1" to allow new user signups.
# When disabled, users can only be created via direct DB insert.
# REGISTRATION_ENABLED=false

# ── CORS (安全) ──
# Comma-separated list of allowed origins.
# SECURITY: do NOT include localhost or LAN IPs in production.
# Default: empty (deny all cross-origin requests with credentials).
# In dev mode (APP_ENV=development): http://localhost:8082
# CORS_ORIGIN=https://your-domain.com

# ── Public URL (安全) ──
# External-accessible base URL for share links.
# When set, the app uses this value for building share URLs instead of
# trusting the Host / X-Forwarded-Proto / Origin request headers.
# Fixes: A08-01 (share URL builder), H-08 (token leakage in logs).
# PUBLIC_URL=https://atmos.your-domain.com

# ── Cookie security ──
# Set to "true" when serving over HTTPS (default: true).
# COOKIE_SECURE=true

# ── App environment ──
# Controls default behaviour for various security features:
# - "production" (unset, default): CORS defaults to empty, enables HTTPS
#   redirect, HSTS only on HTTPS responses.
# - "development"/"dev"/"local": CORS defaults to http://localhost:8082,
#   no HTTPS redirect, etc.
# APP_ENV=production

# ── Per-user upload quota (A04 H2) ──
# Maximum bytes a single user can store. Default: 50 GB (53687091200).
# Set to 0 to disable quota enforcement.
# UPLOAD_QUOTA_BYTES=53687091200

# ── First-user admin guard (H-09) ──
# IMPORTANT: The first registered user will NOT become admin by default,
# even if REGISTRATION_ENABLED=true. Set to "true" only if you understand
# the security implications.
# ALLOW_FIRST_USER_ADMIN=false

# ── Optional integrations ──
# RUST_LOG=info
# SENTRY_DSN=https://...
# SENTRY_ENVIRONMENT=production
