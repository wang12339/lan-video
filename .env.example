# 数据库
# DATABASE_URL：后端直连时使用（本地开发/手工运行）
DATABASE_URL=postgres://user:password@localhost:5432/atmos_video
# Docker Compose 的 postgres 服务密码（必填，勿用弱口令）
DB_PASSWORD=change-me-to-a-strong-db-password

# 服务器
SERVER_PORT=8082
PUBLIC_URL=https://your-domain.com
APP_ENV=production

# 存储
MEDIA_ROOT=./media
WEBAPP_ROOT=./webapp/dist

# 认证
COOKIE_SECURE=true
REGISTRATION_ENABLED=false

# Hash 盐（生产必填）：至少 32 字符的随机值，不能为空/占位符/内置默认值，
# 否则在 APP_ENV != dev/development/test 时后端启动 panic（见 config.rs）。
# 生成命令：openssl rand -hex 32
# 注意：变更会使已有 hashid（视频ID、分享链接）失效。
HASHID_SALT=change-me-to-a-long-random-string

# Redis (可选)
REDIS_URL=redis://localhost:6379

# Prometheus 指标令牌（可选）：/metrics 与 /metrics/prometheus 的只读 Bearer 令牌。
# 为空时两个端点返回 404（默认关闭）。生成命令：openssl rand -hex 32
# METRICS_TOKEN=

# SMTP (可选)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-password

# 管理员
# 首个注册用户默认不授予管理员权限（H-09）。仅在明确理解安全影响时才设为 true。
ALLOW_FIRST_USER_ADMIN=false

# 反向代理客户端 IP（可选）
# TRUSTED_PROXY=1 时才启用代理头信任；TRUSTED_PROXY_PEERS 是可信反代对端 IP
# 白名单（逗号分隔，IPv4/IPv6 均可）。未配置白名单时 X-Forwarded-For /
# cf-connecting-ip 一律被忽略，client_ip 退化为直连对端地址（见 util/net.rs）。
# Nginx 反代示例：宿主机部署填 127.0.0.1,::1；后端在 Docker 中时，它看到的
# 对端通常是网桥网关地址（如 172.17.0.1），需一并加入白名单。
# TRUSTED_PROXY=1
# TRUSTED_PROXY_PEERS=127.0.0.1,::1,172.17.0.1

# 前端崩溃上报端点（构建期变量，构建 webapp 时注入）
# 未配置时默认上报到同源 /client-errors（后端写入 WARN 日志，管理端"日志"页可见）；
# 设为 off 或 none 可关闭上报。跨域自定义端点需该端点允许 CORS。
# VITE_ERROR_REPORT_URL=/client-errors
