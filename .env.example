# 数据库
DATABASE_URL=postgres://user:password@localhost:5432/atmos_video

# 服务器
SERVER_PORT=8082
PUBLIC_URL=https://your-domain.com
APP_ENV=production

# 存储
MEDIA_ROOT=./media
WEBAPP_ROOT=./webapp/dist

# 认证
COOKIE_SECURE=true
REGISTRATION_ENABLED=false

# Hash 盐：生产必须设置为随机值；变更会使已有 hashid（视频ID、分享链接）失效
HASHID_SALT=change-me-to-a-long-random-string

# Redis (可选)
REDIS_URL=redis://localhost:6379

# SMTP (可选)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-password

# 管理员
ALLOW_FIRST_USER_ADMIN=true
